generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(uuid())
  email         String    @unique
  name          String?
  passwordHash  String
  role          String    @default("TESTER") // ADMIN | TESTER
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  testCases             TestCase[]
  testRuns              TestRun[]
  testExecutions        TestExecution[]
  defects               Defect[]
  assignedDefects       Defect[] @relation("DefectAssignee")
  testSuites            TestSuite[]
  automatedResults      AutomatedTestResult[]

  @@index([email])
  @@index([role])
}

model TestSuite {
  id            String      @id @default(uuid())
  name          String
  description   String?
  createdById   String
  createdBy     User        @relation(fields: [createdById], references: [id])
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  testCases     TestCase[]
  testRuns      TestRun[]

  @@index([createdById])
}

model TestCase {
  id              String      @id @default(uuid())
  testCaseId      String      @unique // e.g. TC-001
  title           String
  description     String?
  preconditions   String?
  steps           String      // stored as JSON string
  expectedResult  String
  priority        String      @default("Medium") // Low | Medium | High | Critical
  status          String      @default("Draft")  // Draft | Active | Archived
  suiteId         String?
  suite           TestSuite?  @relation(fields: [suiteId], references: [id])
  createdById     String
  createdBy       User        @relation(fields: [createdById], references: [id])
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  executions      TestExecution[]
  defects         Defect[]

  @@index([testCaseId])
  @@index([suiteId])
  @@index([priority])
  @@index([status])
  @@index([createdById])
}

model TestRun {
  id            String      @id @default(uuid())
  name          String
  description   String?
  status        String      @default("Planned") // Planned | InProgress | Completed
  suiteId       String?
  suite         TestSuite?  @relation(fields: [suiteId], references: [id])
  createdById   String
  createdBy     User        @relation(fields: [createdById], references: [id])
  startedAt     DateTime?
  completedAt   DateTime?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  executions    TestExecution[]

  @@index([suiteId])
  @@index([createdById])
  @@index([status])
}

model TestExecution {
  id            String      @id @default(uuid())
  status        String      // Passed | Failed | Blocked
  notes         String?
  executedAt    DateTime    @default(now())
  executedById  String
  executedBy    User        @relation(fields: [executedById], references: [id])

  testCaseId    String
  testCase      TestCase    @relation(fields: [testCaseId], references: [id])
  testRunId     String
  testRun       TestRun     @relation(fields: [testRunId], references: [id])

  @@unique([testCaseId, testRunId])
  @@index([testCaseId])
  @@index([testRunId])
  @@index([status])
  @@index([executedById])
}

model Defect {
  id              String   @id @default(uuid())
  title           String
  description     String?
  reproSteps      String?
  expectedResult  String?
  actualResult    String?
  severity        String   @default("Medium") // Low | Medium | High | Critical
  priority        String   @default("Medium")
  status          String   @default("Open")   // Open | InProgress | Resolved | Closed
  testCaseId      String?
  testCase        TestCase? @relation(fields: [testCaseId], references: [id])
  reportedById    String
  reportedBy      User     @relation(fields: [reportedById], references: [id])
  assigneeId      String?
  assignee        User?    @relation("DefectAssignee", fields: [assigneeId], references: [id])
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([testCaseId])
  @@index([status])
  @@index([severity])
  @@index([priority])
  @@index([reportedById])
  @@index([assigneeId])
}

model AutomatedTestResult {
  id            String   @id @default(uuid())
  runName       String   // e.g. "CI Playwright Run #42"
  source        String   // e.g. "playwright" | "newman"
  total         Int
  passed        Int
  failed        Int
  blocked       Int
  ciUrl         String?
  ciArtifactUrl String?
  createdById   String?
  createdBy     User?    @relation(fields: [createdById], references: [id])
  createdAt     DateTime @default(now())

  results       AutomatedTestCaseResult[]

  @@index([source])
  @@index([createdAt])
}

model AutomatedTestCaseResult {
  id            String   @id @default(uuid())
  testName      String
  status        String   // passed | failed | skipped
  durationMs    Int?
  errorMessage  String?
  errorStack    String?
  screenshotUrl String?
  traceUrl      String?
  ciJobUrl      String?

  automatedResultId String
  automatedResult   AutomatedTestResult @relation(fields: [automatedResultId], references: [id], onDelete: Cascade)

  @@index([automatedResultId])
  @@index([status])
}
