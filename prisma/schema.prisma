generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["relationJoins"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

model Project {
  id          String   @id @default(uuid())
  name        String
  key         String   @unique // Short identifier like "ECM", "SMS", "CSC"
  description String?
  status      String   @default("ACTIVE") // ACTIVE | ARCHIVED
  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  createdBy   User          @relation(fields: [createdById], references: [id])
  testSuites  TestSuite[]
  testCases   TestCase[]
  testRuns    TestRun[]
  defects     Defect[]
  automatedResults AutomatedTestResult[]

  @@index([createdById])
  @@index([key])
  @@index([status])
}

model User {
  id               String                @id @default(uuid())
  email            String                @unique
  name             String?
  passwordHash     String
  role             String                @default("TESTER")
  isActive         Boolean               @default(true)
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt
  automatedResults AutomatedTestResult[]
  assignedDefects  Defect[]              @relation("DefectAssignee")
  defects          Defect[]
  testCases        TestCase[]
  testExecutions   TestExecution[]
  testRuns         TestRun[]
  testSuites       TestSuite[]
  projects         Project[]
  testExecutionHistories TestExecutionHistory[]

  @@index([email])
  @@index([role])
}

model TestSuite {
  id          String     @id @default(uuid())
  name        String
  description String?
  createdById String
  projectId   String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  testCases   TestCase[]
  testRuns    TestRun[]
  createdBy   User       @relation(fields: [createdById], references: [id])
  project     Project?   @relation(fields: [projectId], references: [id])

  @@index([createdById])
  @@index([projectId])
}

model TestCase {
  id             String          @id @default(uuid())
  testCaseId     String          @unique
  title          String
  description    String?
  preconditions  String?
  steps          String
  expectedResult String
  priority       String          @default("Medium")
  status         String          @default("Draft")
  suiteId        String?
  projectId      String?
  createdById    String
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  defects        Defect[]
  createdBy      User            @relation(fields: [createdById], references: [id])
  suite          TestSuite?      @relation(fields: [suiteId], references: [id])
  project        Project?        @relation(fields: [projectId], references: [id])
  executions     TestExecution[]

  @@index([testCaseId])
  @@index([suiteId])
  @@index([priority])
  @@index([status])
  @@index([createdById])
  @@index([projectId])
}

model TestRun {
  id          String          @id @default(uuid())
  name        String
  description String?
  status      String          @default("Planned")
  suiteId     String?
  projectId   String?
  createdById String
  startedAt   DateTime?
  completedAt DateTime?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  executions  TestExecution[]
  createdBy   User            @relation(fields: [createdById], references: [id])
  suite       TestSuite?      @relation(fields: [suiteId], references: [id])
  project     Project?        @relation(fields: [projectId], references: [id])

  @@index([suiteId])
  @@index([createdById])
  @@index([status])
  @@index([projectId])
}

model TestExecution {
  id           String   @id @default(uuid())
  status       String
  actualResult String?    // Actual result observed during execution
  notes        String?
  executedAt   DateTime @default(now())
  executedById String
  testCaseId   String
  testRunId    String
  executedBy   User     @relation(fields: [executedById], references: [id])
  testCase     TestCase @relation(fields: [testCaseId], references: [id])
  testRun      TestRun  @relation(fields: [testRunId], references: [id])
  history      TestExecutionHistory[]

  @@unique([testCaseId, testRunId])
  @@index([testCaseId])
  @@index([testRunId])
  @@index([status])
  @@index([executedById])
}

model TestExecutionHistory {
  id              String   @id @default(uuid())
  status          String   // The status at this point in history
  actualResult    String?  // Actual result at this point in history
  notes           String?  // Notes at this point in history
  changedAt       DateTime @default(now())
  changedById     String   // Who made the change
  changedBy       User     @relation(fields: [changedById], references: [id])
  testExecutionId String   // Reference to the TestExecution
  testExecution   TestExecution @relation(fields: [testExecutionId], references: [id])

  @@index([testExecutionId])
  @@index([changedById])
  @@index([changedAt])
}

model Defect {
  id             String    @id @default(uuid())
  title          String
  description    String?
  reproSteps     String?
  expectedResult String?
  actualResult   String?
  severity       String    @default("Medium")
  priority       String    @default("Medium")
  status         String    @default("Open")
  testCaseId     String?
  projectId      String?
  reportedById   String
  assigneeId     String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  assignee       User?     @relation("DefectAssignee", fields: [assigneeId], references: [id])
  reportedBy     User      @relation(fields: [reportedById], references: [id])
  testCase       TestCase? @relation(fields: [testCaseId], references: [id])
  project        Project?  @relation(fields: [projectId], references: [id])

  @@index([testCaseId])
  @@index([projectId])
  @@index([status])
  @@index([severity])
  @@index([priority])
  @@index([reportedById])
  @@index([assigneeId])
}

model AutomatedTestResult {
  id            String                    @id @default(uuid())
  runName       String
  source        String
  total         Int
  passed        Int
  failed        Int
  blocked       Int
  ciUrl         String?
  ciArtifactUrl String?
  projectId     String?
  createdById   String?
  createdAt     DateTime                  @default(now())
  results       AutomatedTestCaseResult[]
  createdBy     User?                     @relation(fields: [createdById], references: [id])
  project       Project?                  @relation(fields: [projectId], references: [id])

  @@index([source])
  @@index([createdAt])
  @@index([projectId])
}

model AutomatedTestCaseResult {
  id                String              @id @default(uuid())
  testName          String
  status            String
  durationMs        Int?
  errorMessage      String?
  errorStack        String?
  screenshotUrl     String?
  traceUrl          String?
  ciJobUrl          String?
  automatedResultId String
  automatedResult   AutomatedTestResult @relation(fields: [automatedResultId], references: [id], onDelete: Cascade)

  @@index([automatedResultId])
  @@index([status])
}
